{
  "name": "dev-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard local para gerenciamento de projetos de desenvolvimento",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@dev-dashboard/api",
    "dev:api": "npm run dev --workspace=@dev-dashboard/api",
    "dev:web": "npm run dev --workspace=@dev-dashboard/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
