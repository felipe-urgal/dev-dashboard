{
  "name": "@dev-dashboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import=tsx --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-lines=89 --test-coverage-branches=73 --test-coverage-functions=87 --test test/*.test.ts"
  },
  "dependencies": {
    "@dev-dashboard/contracts": "0.1.0",
    "@dev-dashboard/core": "0.1.0",
    "@dev-dashboard/process-manager": "0.1.0",
    "@dev-dashboard/project-discovery": "0.1.0",
    "@fastify/cors": "11.3.0",
    "@fastify/websocket": "11.3.0",
    "fastify": "^5.10.0",
    "mysql2": "^3.24.2",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.1",
    "tsx": "^4.23.1"
  }
}
