{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": [
      "node"
    ]
  },
  "references": [
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/project-discovery"
    }
  ],
  "include": [
