{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "jsdom"
    ],
    "noEmit": true
  },
  "include": [
    "src/api.ts",
    "src/stores/dashboard.ts",
    "src/utils/**/*.ts",
    "src/components/**/*.vue",
    "src/views/**/*.vue",
    "test/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
