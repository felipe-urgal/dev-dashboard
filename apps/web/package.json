{
  "name": "@dev-dashboard/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run --coverage",
    "test:e2e": "tsc -p e2e/tsconfig.json --noEmit && playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dev-dashboard/contracts": "0.1.0",
    "@dev-dashboard/core": "0.1.0",
    "@heroicons/vue": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "naive-ui": "^2.44.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.8"
  }
}
