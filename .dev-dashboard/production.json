{
  "version": 1,
  "production": {
    "enabled": true,
    "strategy": "self-update",
    "provider": "none",
    "branch": "main",
    "documentation": "docs/architecture/self-production.md",
    "commands": {
      "status": "prod:status",
      "check": "prod:check"
    },
    "policies": {
      "backup": "not-configured",
      "migrations": "not-configured",
      "rollback": "not-configured"
    }
  }
}
