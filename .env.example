# Copie este arquivo para .env.local quando precisar customizar o ambiente local.
# npm run dev carrega .env.local automaticamente.

# API local
# Porta padrão: 4343
DEV_DASHBOARD_API_PORT=4343

# Logging do processo Fastify (opcional).
# LOG_LEVEL=info

# Diretórios locais opcionais. Quando omitidos, o Dev Dashboard usa os
# diretórios XDG/padrões documentados em docs/operations-and-troubleshooting.md.
# DEV_DASHBOARD_CONFIG_DIR=/caminho/absoluto/para/config
# DEV_DASHBOARD_STATE_DIR=/caminho/absoluto/para/state
# DEV_DASHBOARD_LOG_RETENTION_DAYS=

# Integração Vercel — necessária somente para projetos
# strategy=git-managed + provider=vercel.
# Nunca versione tokens reais.
VERCEL_TOKEN=
# VERCEL_TEAM_ID=team_xxx

# As variáveis abaixo são internas/efêmeras e NÃO devem ser configuradas aqui:
# DEV_DASHBOARD_LOCAL_DISTRIBUTION
# DEV_DASHBOARD_WEB_DIST
# DEV_DASHBOARD_BROWSER_BOOTSTRAP
# DEV_DASHBOARD_RUNTIME_REVISION
# DEV_DASHBOARD_SELF_UPDATE_REPOSITORY_ROOT
#
# Overrides operacionais do self-update agent também não são carregados
# automaticamente por `npm run self-update:agent`; exporte-os explicitamente
# no shell somente quando necessário:
# DEV_DASHBOARD_SELF_UPDATE_INSTALL_DIR
# DEV_DASHBOARD_SELF_UPDATE_RUNTIME_DIR
